# Скопировать в .env и заполнить. Сам .env в git не попадает (.gitignore).
# Читается классом Settings (src/adlex/config.py), префикс обязателен.

# local | docker | prod — влияет на формат логов
ADLEX_ENV=local

# Обязательные: без них сервис не стартует
ADLEX_DATABASE_URL=postgresql+asyncpg://adlex:adlex@localhost:5432/adlex
ADLEX_LLM_API_KEY=

# Необязательные: значения по умолчанию заданы в Settings
ADLEX_REDIS_URL=redis://localhost:6379/0
ADLEX_LLM_BASE_URL=https://openrouter.ai/api/v1
ADLEX_MODEL_MAIN=qwen/qwen3.8-flash
# OpenRouter не принимает запросы с российских адресов — нужен прокси
ADLEX_LLM_PROXY=http://127.0.0.1:10809
